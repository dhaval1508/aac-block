generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  STAFF
  STOCKER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  LOADING
  LOADED
  DISPATCHED
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMode {
  BANK_TRANSFER
  UPI
  CASH
  CHEQUE
}

enum StockType {
  IN
  OUT
}

model User {
  id              String          @id @default(cuid())
  role            Role            @default(CUSTOMER)
  name            String
  mobile          String          @unique
  email           String          @unique
  passwordHash    String
  companyName     String?
  gstin           String?
  billingAddress  String?
  deliveryAddress String?
  city            String?
  state           String?         @default("Gujarat")
  pincode         String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customerOrders    Order[]            @relation("CustomerOrders")
  assignedOrders    Order[]            @relation("StaffAssignedOrders")
  stockMovements    StockMovement[]
  paymentsCreated   Payment[]
  orderEvents       OrderEvent[]
  messageLogs       MessageLog[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  @@index([role])
  @@index([mobile])
}

model Product {
  id             String          @id @default(cuid())
  name           String          @default("AAC Block")
  category       String          @default("AAC_BLOCK") // AAC_BLOCK, MORTAR, ADHESIVE
  brand          String          @default("Swarnim")
  sizeLabel      String          // e.g. "4 Inch", "6 Inch", "8 Inch", "9 Inch", "40kg Bag"
  dimensions     String          // e.g. "600 × 200 × 100 mm", "40 Kg Bag"
  lengthMm       Int             @default(600)
  heightMm       Int             @default(200)
  widthMm        Int             // 75, 100, 115, 125, 150, 175, 200, 225, 230, 300
  cbmPerBlock    Decimal         @db.Decimal(10, 4) // (L * H * W) / 1,000,000,000
  blocksPerCbm   Decimal         @db.Decimal(10, 2) // 1 / cbmPerBlock
  bagWeightKg    Decimal?        @db.Decimal(10, 2)
  coverageSqft   Decimal?        @db.Decimal(10, 2)
  consumptionRate Decimal?       @db.Decimal(10, 4) // Configured mortar rate
  jointThicknessMm Decimal?      @default(3.0) @db.Decimal(5, 2)
  price          Decimal         @default(0) @db.Decimal(12, 2)
  gstRate        Decimal         @default(18.00) @db.Decimal(5, 2)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orders         Order[]
  orderItems     OrderItem[]
  movements      StockMovement[]

  @@index([sizeLabel])
  @@index([category])
  @@index([active])
}

model Order {
  id              String          @id @default(cuid())
  orderNo         String          @unique // e.g. "ORD-2026-1001" or "SWA-1001"
  customerId      String
  customer        User            @relation("CustomerOrders", fields: [customerId], references: [id])
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id])
  quantity        Int             @default(0)
  loadedQuantity  Int             @default(0)
  totalCbm        Decimal?        @db.Decimal(12, 4)
  totalSqft       Decimal?        @db.Decimal(12, 2)
  hasMortar       Boolean         @default(false)
  hasAdhesive     Boolean         @default(false)
  adhesiveBags    Int             @default(0)
  rate            Decimal         @default(0) @db.Decimal(12, 2)
  gstRate         Decimal         @default(18.00) @db.Decimal(5, 2)
  subtotal        Decimal         @db.Decimal(14, 2)
  gstAmount       Decimal         @db.Decimal(14, 2)
  totalAmount     Decimal         @db.Decimal(14, 2)
  deliveryAddress String
  requestedDate   DateTime?
  notes           String?
  status          OrderStatus     @default(PENDING)
  invoiceNo       String?         @unique // e.g. "INV-2026-0001"
  shareToken      String?         @unique // Secure public token for WhatsApp
  paymentStatus   PaymentStatus   @default(PENDING)
  paidAmount      Decimal         @default(0) @db.Decimal(14, 2)
  
  assignedStaffId String?
  assignedStaff   User?           @relation("StaffAssignedOrders", fields: [assignedStaffId], references: [id])

  confirmedAt     DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           OrderItem[]
  transport       Transport?
  events          OrderEvent[]
  payments        Payment[]
  movements       StockMovement[]
  messageLogs     MessageLog[]

  @@index([status])
  @@index([customerId])
  @@index([assignedStaffId])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  productType    String          @default("AAC_BLOCK") // AAC_BLOCK, MORTAR, ADHESIVE
  productName    String
  sizeLabel      String?
  dimensions     String?
  quantity       Int
  loadedQuantity Int             @default(0)
  cbmPerUnit     Decimal?        @db.Decimal(10, 4)
  totalCbm       Decimal?        @db.Decimal(12, 4)
  sqftPerUnit    Decimal?        @db.Decimal(10, 2)
  totalSqft      Decimal?        @db.Decimal(12, 2)
  rate           Decimal         @db.Decimal(12, 2)
  gstRate        Decimal         @default(18.00) @db.Decimal(5, 2)
  subtotal       Decimal         @db.Decimal(14, 2)
  gstAmount      Decimal         @db.Decimal(14, 2)
  totalAmount    Decimal         @db.Decimal(14, 2)
  createdAt      DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([productType])
}

model Transport {
  id               String    @id @default(cuid())
  orderId          String    @unique
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transporterName  String?
  truckNumber      String
  driverName       String
  driverMobile     String
  expectedDelivery DateTime?
  assignedAt       DateTime  @default(now())
}

model OrderEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  title       String
  note        String?
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Payment {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Decimal     @db.Decimal(14, 2)
  mode        PaymentMode
  referenceNo String?
  paidAt      DateTime    @default(now())
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model StockMovement {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type          StockType // IN or OUT
  quantityDelta Int       // Positive for IN, Negative for OUT
  referenceNo   String?
  note          String?
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model MessageLog {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messageType String    // invoice, confirmed, assigned, loading, loaded, dispatched, delivered, payment
  mobile      String
  messageText String
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([orderId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?
  title     String
  message   String
  type      String   // NEW_ORDER, ORDER_ASSIGNED, STATUS_CHANGE, DISPATCH, etc.
  orderId   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([role])
  @@index([read])
  @@index([createdAt])
}

model NotificationDeliveryLog {
  id             String   @id @default(cuid())
  notificationId String?
  userId         String?
  endpoint       String
  status         String   // SUCCESS | FAILED
  statusCode     Int?
  error          String?
  sentAt         DateTime @default(now())

  @@index([userId])
  @@index([sentAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
